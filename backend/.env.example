# ==============================================================================
# Backend Environment Configuration Template
# Copy this file to backend/.env and fill in your credentials.
# ==============================================================================

# 1. Google Gemini API Key (Required for Primary AI Models)
# Generate from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. NVIDIA NIM API Key (High-Speed Multi-Model Failover: 120B & 11B models)
NVIDIA_API_KEY=your_nvidia_api_key_here

# 3. Google Cloud / Firebase Project ID
GOOGLE_CLOUD_PROJECT=avid-pentameter-mr6mz

# 4. Server Port Configuration (Optional, defaults to 8000)
PORT=8000

# 5. Optional: BigQuery Location
# BIGQUERY_LOCATION=US
