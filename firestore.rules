rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Single owner-bound rule covers every current and future
    // subcollection under users/{userId}/ — config, sessions,
    // journals, stats, subscription, etc. Do not add a
    // narrower per-subcollection rule; it silently fails to
    // protect siblings (see architecture.md Invariant 3).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                          && request.auth.uid == userId;
    }

    // Everything outside /users/** (e.g. a future
    // system/quota_guard doc for the optional global circuit
    // breaker) is server-only by default — deny-all here, access
    // only via the Admin SDK from Cloud Run.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
